# Copy this file to "backend/.env" and fill in your own values.
# .env is ignored by git, so your password never gets uploaded.

# ---------- Database: PostgreSQL on Supabase ----------
# Where to find these: Supabase dashboard -> your project -> "Connect" button
# -> choose "Session pooler". Use the host, user and your database password.
DB_URL=jdbc:postgresql://<host>:5432/postgres?sslmode=require
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=

# Optional: change only if port 8080 is already in use
# SERVER_PORT=8080

# ---------- Email: Brevo ----------
# See README, "Set up Brevo". The API key is a secret: keep it only in this .env file.
BREVO_API_KEY=
# The sender address you verified in Brevo (not your @cit.edu address)
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=CheckedIn

# ---------- Sign-in session ----------
# The session cookie is "Secure" (HTTPS only, NFR-009). Chrome, Edge and Firefox should still keep it
# on http://localhost. Only if your browser does not, uncomment this line for LOCAL testing:
# SESSION_COOKIE_SECURE=false

# ---------- Sign in with GitHub ----------
# See README, "Set up GitHub sign-in". The client secret is a secret: keep it only in this file.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- Professors (FR-004) ----------
# Comma-separated @cit.edu emails of professors, e.g. maria.santos@cit.edu,jose.reyes@cit.edu
# Everyone else who signs in is a student. Restart the backend after a change.
PROFESSOR_EMAILS=
