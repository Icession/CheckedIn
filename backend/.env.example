# Copy this file to "backend/.env" and fill in your own values.
# .env is ignored by git, so your password never gets uploaded.

# ---------- Database: PostgreSQL on Supabase ----------
# Where to find these: Supabase dashboard -> your project -> "Connect" button
# -> choose "Session pooler". Use the host, user and your database password.
DB_URL=jdbc:postgresql://<host>:5432/postgres?sslmode=require
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=

# Optional: change only if port 8080 is already in use
# SERVER_PORT=8080
