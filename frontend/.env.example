# Copy this file to "frontend/.env" and fill in the values.
# Vite reads .env only when "npm run dev" starts, so restart it after a change.
# Every VITE_ value ends up in the browser, so never put a secret here.

# Backend address. Leave empty in development: the Vite proxy sends /api to localhost:8080.
VITE_API_BASE_URL=

# ---------- Microsoft sign-in (Entra ID) ----------
# Required. Use the same values as ENTRA_CLIENT_ID and ENTRA_TENANT_ID in backend/.env.
# See README, "Set up Microsoft sign-in".
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=823cde44-4433-456d-b801-bdf0ab3d41fc
