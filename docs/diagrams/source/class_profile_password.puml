@startuml
!include cls_style.iuml
skinparam nodesep 20
left to right direction
skinparam ranksep 60

package "Controllers (REST API)" #FAFAFA {
  class ProfileController {
    + getProfile()
    + updateProfile(request)
  }
  class UpdateProfileRequest <<DTO>> {
    + firstName : String
    + lastName : String
  }
  class PasswordController {
    + signIn(request)
    + forgotPassword(request)
    + resetPassword(request)
    + changePassword(request)
  }
}

package "Services" #FAFAFA {
  class ProfileService {
    + getProfile(email) : ProfileResponse
    + updateName(email, request) : ProfileResponse
  }
  class PasswordSignInService {
    + signIn(email, password) : CurrentUserResponse
  }
  class PasswordResetService {
    + requestReset(email)
    + resetPassword(request)
    + useUpOpenLinks(user, now)
  }
  class PasswordChangeService {
    + changePassword(email, request)
  }
  class AuthService {
    + signInWithPassword(email)
    + saveName(email, githubId, request)
  }
  class SessionService {
    + startSession(email, request, response)
  }
  class EmailAddressChecker {
    + normalize(email) : String
    + isAllowed(email) : boolean
  }
  class PasswordRules <<helper>> {
    + checkNotEmailAndConfirmed(password, confirm, email)
  }
  class NameRules <<helper>> {
    + cleanUp(name) : String
  }
}

package "Entities" #FAFAFA {
  class PasswordResetToken {
    - tokenHash : String
    - expiresAt : LocalDateTime
    - usedAt : LocalDateTime
    + isUsed() : boolean
    + isExpired(now) : boolean
    + markUsed(now)
  }
  class PasswordLockout {
    - email : String
    - wrongTries : int
    - lockedUntil : LocalDateTime
    + isLocked(now) : boolean
    + recordWrongTry(now, settings)
  }
}

package "External Integration" #FAFAFA {
  interface EmailService {
    + send(to, template, data) : String
  }
  class BrevoEmailService
}

ProfileController --> ProfileService
ProfileService --> AuthService
ProfileController ..> UpdateProfileRequest
UpdateProfileRequest ..> NameRules
PasswordController --> PasswordSignInService
PasswordController --> PasswordResetService
PasswordController --> PasswordChangeService
PasswordController --> SessionService
PasswordSignInService --> AuthService
PasswordSignInService --> EmailAddressChecker
PasswordSignInService ..> PasswordLockout
PasswordResetService --> EmailService
PasswordResetService --> EmailAddressChecker
PasswordResetService ..> PasswordResetToken
PasswordResetService ..> PasswordRules
PasswordChangeService --> AuthService
PasswordChangeService --> PasswordResetService
PasswordChangeService ..> PasswordRules
EmailService <|.. BrevoEmailService
@enduml
